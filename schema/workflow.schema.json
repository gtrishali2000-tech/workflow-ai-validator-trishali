{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/workflow.schema.json",
  "type": "object",
  "required": ["trigger", "actions"],
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },

    "trigger": {
      "type": "object",
      "required": ["type", "name"],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "customer_reply",
            "appointment_booked",
            "form_submission",
            "payment_received",
            "contact_tag_added"
          ]
        },
        "name": { "type": "string", "minLength": 1 },
        "conditions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["field", "operator", "value"],
            "properties": {
              "field": { "type": "string", "minLength": 1 },
              "operator": {
                "type": "string",
                "enum": ["equals", "contains_any", "in", "regex"]
              },
              "value": {
                "oneOf": [
                  { "type": "string" },
                  { "type": "number" },
                  {
                    "type": "array",
                    "items": { "type": "string" },
                    "minItems": 1
                  }
                ]
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },

    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["type", "name"],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "send_email",
              "send_sms",
              "add_tag_to_contact",
              "webhook_call",
              "internal_notification"
            ]
          },
          "name": { "type": "string", "minLength": 1 },
          "order": { "type": "integer", "minimum": 0 },
          "attributes": {
            "oneOf": [
              {
                "type": "object",
                "required": ["subject", "html"],
                "properties": {
                  "subject": { "type": "string" },
                  "html": { "type": "string" },
                  "attachments": {
                    "type": "array",
                    "items": { "type": "string" }
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "object",
                "required": ["body"],
                "properties": { "body": { "type": "string" } },
                "additionalProperties": false
              },
              {
                "type": "object",
                "required": ["tags"],
                "properties": {
                  "tags": {
                    "type": "array",
                    "items": { "type": "string" },
                    "minItems": 1
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "object",
                "required": ["method", "url"],
                "properties": {
                  "method": {
                    "type": "string",
                    "enum": ["GET", "POST", "PUT", "PATCH"]
                  },
                  "url": { "type": "string", "format": "uri" },
                  "headers": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": ["key", "value"],
                      "properties": {
                        "key": { "type": "string" },
                        "value": { "type": "string" }
                      },
                      "additionalProperties": false
                    }
                  },
                  "customData": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": ["key", "value"],
                      "properties": {
                        "key": { "type": "string" },
                        "value": { "type": "string" }
                      },
                      "additionalProperties": false
                    }
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "object",
                "required": ["title", "body"],
                "properties": {
                  "title": { "type": "string" },
                  "body": { "type": "string" },
                  "userType": {
                    "type": "string",
                    "enum": ["all", "owner", "assignee", "team"]
                  },
                  "redirectPage": {
                    "type": "string",
                    "enum": ["conversation", "contact", "dashboard"]
                  }
                },
                "additionalProperties": false
              }
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },

  "additionalProperties": false
}
